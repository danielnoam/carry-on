<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Read aloud (0.27.0): a media-playback service that goes on with the
         screen off. TextToSpeech can only find the phone's engine when the
         app says it looks for one (Android 11's package visibility). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Downloads (0.27.9): a data-sync service that keeps the app running
         while pages are saved, with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Feeds (0.28.4): read every few hours with the app closed, a job
         that survives a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application>
        <service
            android:name="io.github.danielnoam.carryon.share.SpeechService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name="io.github.danielnoam.carryon.share.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="io.github.danielnoam.carryon.share.FeedCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Home screen widgets (0.29.0). -->
        <receiver
            android:name="io.github.danielnoam.carryon.share.ReadingWidget"
            android:exported="false"
            android:label="@string/carryon_w_reading">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/carryon_widget_reading_info" />
        </receiver>
        <receiver
            android:name="io.github.danielnoam.carryon.share.FeedsWidget"
            android:exported="false"
            android:label="@string/carryon_w_feeds">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/carryon_widget_feeds_info" />
        </receiver>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/waypage_widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/waypage_w_pad">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/waypage_w_highlight"
        android:textColor="@color/waypage_w_muted"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/w_quote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="7"
        android:textColor="@color/waypage_w_ink"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/w_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/waypage_w_muted"
        android:textSize="12sp"
        android:textStyle="italic" />
    <TextView
        android:id="@+id/w_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/waypage_w_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
